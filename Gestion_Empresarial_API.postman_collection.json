	"item": [
		{
			"name": "Autenticación",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Guardar cookies de sesión automáticamente",
									"pm.test(\"Login exitoso\", function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.cookies.has('JSESSIONID')).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "username",
									"value": "admin@gestionempresarial.com",
									"description": "Email del usuario"
								},
								{
									"key": "password",
									"value": "admin123",
									"description": "Contraseña"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"login"
							]
						},
						"description": "Iniciar sesión en el sistema. Devuelve cookie JSESSIONID que se usa en todas las peticiones posteriores.\n\n**Usuarios disponibles:**\n- Admin: admin@gestionempresarial.com / admin123\n- Supervisor: supervisor@gestionempresarial.com / super123"
					},
					"response": []
				},
				{
					"name": "Logout",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/logout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"logout"
							]
						},
						"description": "Cerrar sesión y limpiar cookie JSESSIONID."
					},
					"response": []
				}
			],
			"description": "Endpoints de autenticación con Spring Security"
		},
